# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL with pgvector, run in Docker on port 5433:
#   docker run -d --name cv-pgvector --restart unless-stopped -e POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD #     -p 5433:5432 -v cv_pgdata:/var/lib/postgresql/data pgvector/pgvector:pg17
#   docker exec cv-pgvector psql -U postgres -c "CREATE DATABASE cv_generator"
#   docker exec cv-pgvector psql -U postgres -c "CREATE DATABASE cv_generator_test"   (used by pytest)
#   alembic upgrade head
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5433/cv_generator

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Claude API key from https://console.anthropic.com. Never commit the real one.
ANTHROPIC_API_KEY=sk-ant-replace-me
AI_MODEL=claude-haiku-5-5

# PDF downloads: WeasyPrint renderer in Docker (listens on this machine only).
#   docker build -t cv-pdf-renderer pdf_renderer
#   docker run -d --name cv-pdf --restart unless-stopped -p 127.0.0.1:5001:5001 cv-pdf-renderer
PDF_RENDERER_URL=http://127.0.0.1:5001

# Docker Compose (docker-compose.yml): password for the database container it creates.
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_PASSWORD=replace-with-a-long-random-value
